    font-weight: 500;
	 background-color: rgb(204, 188, 255);
	 border: 2px solid #b17ddf; 
    color: black;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #b17ddf;
    background-color: white;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #b17ddf;         /* fundal bifa – pastel mov */
    border: 2px solid #8f44d4;
}

